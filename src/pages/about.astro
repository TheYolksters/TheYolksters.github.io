---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { site } from "@/config/site";
import { buttonVariants } from "@/components/ui/button";
import banner from "@/assets/about-banner.png";
---

<Layout
  title="About Us"
  description="Who The Yolksters are: a family-friendly esports squad flying the [Ch1kn] banner."
>
  <article class="mx-auto max-w-4xl px-4 py-12 md:py-16">
    <Image
      src={banner}
      alt="The Yolksters banner art"
      class="w-full rounded-2xl border border-nebula-edge/60"
      loading="eager"
      widths={[640, 1024, 1600]}
      sizes="(min-width: 1024px) 896px, 100vw"
    />

    <h1 class="mt-10 text-4xl font-extrabold md:text-5xl">
      Welcome to the <span class="text-yolk">Coop</span>
    </h1>

    <div class="mt-6 space-y-4 text-lg leading-relaxed text-dust">
      <p>
        We aren't your standard, run-of-the-mill esports organization. We are{" "}
        <strong class="text-star">{site.name}</strong> — a family-friendly squad
        built on high-tier gameplay, undeniable chemistry, and just enough chaos
        to keep our opponents scrambling.
      </p>
      <p>
        Flying under the official{" "}
        <span class="font-semibold text-yolk">{site.tag}</span> banner, we
        believe that taking the game seriously doesn't mean you have to
        take yourself too seriously. We bring the heat, we bring the hype, and we
        keep things clean so gaming fans of all ages can join the flock.
      </p>
    </div>

    <h2 class="mt-12 text-3xl font-extrabold">
      Our Vibe &amp; <span class="text-glow">Vision</span>
    </h2>

    <div class="mt-6 space-y-4 text-lg leading-relaxed text-dust">
      <p>
        If you see our signature crest — wings on the keyboard and a
        spaceship-level trajectory — you know exactly what you're up against.
        We are dedicated to building a positive, family-friendly community where
        competitive excellence meets good-natured fun.
      </p>
      <p>
        Whether we're grinding the ranked ladders or hosting streams accessible
        to gamers of all ages, {site.name} always deliver. We aren't just here to
        play; we're here to <strong class="text-star">rule the roost</strong>.
      </p>
    </div>

    <div class="mt-12">
      <a href="/roster/" class={buttonVariants({ size: "lg" })}>
        Meet the Flock
      </a>
    </div>
  </article>
</Layout>
