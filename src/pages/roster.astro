---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { site } from "@/config/site";
import { badgeVariants } from "@/components/ui/badge";
import memberGrai from "@/assets/member-grai.png";
import memberDia from "@/assets/member-dia.png";
import memberKyle from "@/assets/member-kyle.png";
import team from "@/assets/team.png";

const portraits = { grai: memberGrai, dia: memberDia, kyle: memberKyle } as const;
---

<Layout
  title="Roster"
  description="The Yolksters lineup: TheGrai, DarlingDia and KoalaKyle — technical precision, raw firepower and unpredictable energy."
>
  <section class="starfield">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h1 class="text-4xl font-extrabold md:text-5xl">
        The <span class="text-yolk">Roster</span>
      </h1>
      <p class="mt-3 max-w-prose text-lg text-dust">
        Every great team needs a balanced lineup — ours brings the perfect mix
        of technical precision, raw firepower, and unpredictable energy.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          site.members.map((m) => (
            <div class="flex flex-col overflow-hidden rounded-2xl border border-nebula-edge bg-card shadow-[0_8px_40px_-16px_rgb(0_0_0/0.6)] transition-all hover:-translate-y-1 hover:border-yolk/60">
              <Image
                src={portraits[m.id]}
                alt={`${m.name} character art`}
                width={1024}
                height={1024}
                widths={[320, 640, 1024]}
                class="aspect-square w-full object-cover"
                sizes="(min-width: 768px) 33vw, 100vw"
              />
              <div class="flex flex-1 flex-col gap-3 p-6">
                <div class="flex flex-col items-start gap-2">
                  <h2 class="font-display text-2xl font-bold">{m.name}</h2>
                  <span class={badgeVariants({ variant: "glow" })}>{m.role}</span>
                </div>
                <p class="text-sm leading-relaxed text-dust">{m.blurb}</p>
                <div class="mt-auto pt-2">
                  {m.twitch || m.youtube ? (
                    <div class="flex gap-3">
                      {m.twitch && (
                        <a
                          class="text-sm font-semibold text-glow hover:underline"
                          href={`https://twitch.tv/${m.twitch}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Twitch
                        </a>
                      )}
                      {m.youtube && (
                        <a
                          class="text-sm font-semibold text-glow hover:underline"
                          href={`https://youtube.com/${m.youtube}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          YouTube
                        </a>
                      )}
                    </div>
                  ) : (
                    <p class="text-xs uppercase tracking-wider text-dust">
                      Channels coming soon
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-16">
        <Image
          src={team}
          alt="The Yolksters squad crest — the whole flock in spacesuits at the keyboard"
          class="w-full rounded-2xl border border-nebula-edge/60"
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1152px) 1120px, 100vw"
        />
      </div>
    </div>
  </section>
</Layout>
