---
import { Image } from "astro:assets";
import wordmark from "@/assets/wordmark.png";
import { site } from "@/config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-nebula-edge/60 bg-nebula/40">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-10 text-center"
  >
    <Image
      src={wordmark}
      alt={`${site.name} wordmark`}
      width={168}
      densities={[1, 2, 3]}
      class="h-14 w-auto"
    />
    <p class="font-display text-lg font-bold text-yolk">{site.tag}</p>
    <p class="max-w-md text-sm text-dust">
      {site.tagline} Family-friendly esports — gamers of all ages welcome in the
      flock.
    </p>

    {
      site.socials.length > 0 && (
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
          {site.socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-glow hover:underline"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="text-xs text-dust">
      © {year} {site.name}. All eggs reserved.
    </p>
  </div>
</footer>
