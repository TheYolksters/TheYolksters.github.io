---
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
import { site } from "@/config/site";

const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/roster/", label: "Roster" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.replace(/\/$/, "") === href.replace(/\/$/, "");
---

<header
  class="sticky top-0 z-50 border-b border-nebula-edge/60 bg-cosmos/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <Image
        src={logo}
        alt=""
        width={80}
        height={80}
        class="size-10 shrink-0 rounded-full ring-1 ring-nebula-edge"
        loading="eager"
      />
      <span class="truncate font-display text-lg font-extrabold tracking-wide">
        {site.name} <span class="hidden text-yolk sm:inline">{site.tag}</span>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-semibold transition-colors",
                  isActive(item.href)
                    ? "text-yolk underline decoration-2 underline-offset-8"
                    : "text-dust hover:bg-nebula hover:text-star",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
