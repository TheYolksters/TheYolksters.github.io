---
import { Image } from "astro:assets";
import wordmark from "@/assets/wordmark.png";
import MobileNav from "@/components/MobileNav";
import { nav, site } from "@/config/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.replace(/\/$/, "") === href.replace(/\/$/, "");
---

<header
  class="sticky top-0 z-50 border-b border-nebula-edge/60 bg-cosmos/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex min-w-0 items-center">
      <Image
        src={wordmark}
        alt={site.name}
        width={128}
        densities={[1, 2, 3]}
        class="h-10 w-auto shrink-0"
        loading="eager"
      />
    </a>

    <!-- Desktop: links inline -->
    <nav aria-label="Main navigation" class="hidden md:block">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-semibold transition-colors",
                  isActive(item.href)
                    ? "text-yolk underline decoration-2 underline-offset-8"
                    : "text-dust hover:bg-nebula hover:text-star",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      Mobile: collapse into a sheet menu. `client:media` means the React
      bundle is only ever downloaded on viewports that can see the button —
      desktop visitors pay nothing for it.
    */}
    <div class="md:hidden">
      <MobileNav
        client:media="(max-width: 767px)"
        items={nav}
        pathname={path}
        label={site.name}
      />
    </div>
  </div>
</header>
